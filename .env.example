# Data plane (bun run db:up starts postgres + electric via docker)
# Postgres — server routes, agent tools and scripts write through this
DATABASE_URL=postgres://postgres:password@localhost:5442/bulbus
# Electric HTTP API — the browser streams shapes from here
VITE_ELECTRIC_URL=http://localhost:5444

# Electric Agents (bun run agents:runtime starts the coordinator via docker)
ELECTRIC_AGENTS_URL=http://localhost:4437
VITE_AGENTS_URL=https://localhost:8444   # coordinator via Caddy (HTTP/2); http://localhost:4437 without the proxy
AGENTS_APP_PORT=4440
AGENTS_PROVIDER=openai
AGENTS_MODEL=gpt-5.1
# Key for the chosen provider (agent server)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Any pi-ai provider: openai | anthropic | xai | openrouter … with its key and a model id that belongs to it
# AGENTS_PROVIDER=xai
# AGENTS_MODEL=grok-4-1-fast
# XAI_API_KEY=
# Thinking level (minimal|low|medium|high|xhigh) and, for ids newer than pi-ai's catalogue, the catalogued sibling to clone
AGENTS_REASONING=high
# AGENTS_MODEL_LIKE=gpt-5.5

# Auth (better-auth). Anonymous "temp user" sessions work with just these two.
# Secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Origin the app is served from — must match the OAuth redirect URI host
BETTER_AUTH_URL=http://localhost:3005

# Google sign-in + One Tap (optional; both features are disabled when unset).
# Authorised redirect URI: $BETTER_AUTH_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same value as GOOGLE_CLIENT_ID — the browser needs it to render One Tap
VITE_GOOGLE_CLIENT_ID=
