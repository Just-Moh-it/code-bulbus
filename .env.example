# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=

# Electric Agents (bun run agents:runtime starts the coordinator via docker)
ELECTRIC_AGENTS_URL=http://localhost:4437
VITE_AGENTS_URL=http://localhost:4437
AGENTS_APP_PORT=4440
AGENTS_MODEL=claude-sonnet-4-6
# Required by the agent server
ANTHROPIC_API_KEY=
