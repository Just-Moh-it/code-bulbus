// Cloudflare Workers config for the bulbus web app.
//
// Modern TanStack Start deploys to *Workers with static assets* — the successor
// to Cloudflare Pages for full-stack apps. There is no Pages project: one Worker
// serves the static client build and runs SSR + the server routes.
//
//   bun run build:cf     CF_BUILD=1 vite build  (Cloudflare plugin instead of nitro)
//   bun run preview:cf   build, then run the Worker locally in workerd
//   bun run deploy       build:cf && wrangler deploy
//   bun run cf:typegen   regenerate worker-configuration.d.ts from this file
//
// Full walkthrough (Hyperdrive, Electric, secrets, what stays on the VM):
// docs/DEPLOY-CF.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bulbus",
  "compatibility_date": "2026-08-24",
  // Needed by node:* imports pulled in through the server routes. It also makes
  // `process.env` auto-populated from `vars` + secrets (compat date >= 2025-04-01),
  // so the existing `process.env.X` reads in src/routes/api/** keep working.
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },

  // `assets.directory` is filled in automatically by @cloudflare/vite-plugin from
  // the client build, so it must NOT be set here. This block only declares the
  // routing behaviour and the binding.
  //   not_found_handling "none" -> unmatched paths fall through to the Worker,
  //   which is what SSR + /api/** need (this is not a SPA).
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
  },

  // ---------------------------------------------------------------------------
  // Postgres via Hyperdrive (pooling + TLS termination at the edge).
  //
  // Create it once, then paste the printed id below and uncomment:
  //   bunx wrangler hyperdrive create bulbus-pg --connection-string="postgres://…"
  //
  // Server code reads the pooled URL from `env.HYPERDRIVE.connectionString`
  // (import { env } from 'cloudflare:workers') and passes it to porsager
  // `postgres()` with `{ prepare: false, max: 5 }`. Keep DATABASE_URL as the
  // fallback for the VM/local paths.
  // ---------------------------------------------------------------------------
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "<HYPERDRIVE_ID>",
  //     // used by `wrangler dev` only; the deployed Worker ignores it
  //     "localConnectionString": "postgres://postgres:postgres@localhost:5432/bulbus"
  //   }
  // ],

  // ---------------------------------------------------------------------------
  // Non-secret runtime values. Readable in server routes as `process.env.X`
  // (or `env.X` from 'cloudflare:workers'). Point them at the VM origin that
  // runs the Electric Agents coordinator and arduino-cli.
  //
  // NOTE: `VITE_*` variables are NOT set here. Vite inlines them into the client
  // bundle at build time, so they must be in the environment of `bun run build:cf`
  // (a .env file locally, or the Workers Builds env vars in CI):
  //   VITE_ELECTRIC_URL, VITE_AGENTS_URL, VITE_GOOGLE_CLIENT_ID
  //
  // Secrets are never stored here — `bunx wrangler secret put <NAME>`:
  //   DATABASE_URL (only if Hyperdrive is not used), BETTER_AUTH_SECRET,
  //   GOOGLE_CLIENT_SECRET, OPENAI_API_KEY / ANTHROPIC_API_KEY
  // ---------------------------------------------------------------------------
  "vars": {
    "ELECTRIC_AGENTS_URL": "https://vm.bulbus.mohitya.dev/agents",
    "BETTER_AUTH_URL": "https://bulbus.mohitya.dev",
    // Origin of the always-on box that keeps arduino-cli and the agents runtime
    // (see docs/DEPLOY-CF.md, "stays on the VM").
    "VM_ORIGIN": "https://vm.bulbus.mohitya.dev",
  },
}
